#. Plugin URI of the plugin
#: lkn-wc-gateway-cielo.php
msgid "https://www.linknacional.com.br/wordpress/woocommerce/cielo/"
msgstr "https://www.linknacional.com.br/wordpress/woocommerce/cielo/"

#. Description of the plugin
#: lkn-wc-gateway-cielo.php
msgid "Adds the Cielo API 3.0 Payments gateway to your WooCommerce website."
msgstr ""
"Adiciona o método de pagamento Cielo API 3.0 para seu site WooCommerce."

